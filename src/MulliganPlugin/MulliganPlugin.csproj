<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>HstMulligan.Plugin</RootNamespace>
    <AssemblyName>HstMulliganV2</AssemblyName>
    <Version>0.1.0</Version>
    <!-- Folder containing HearthstoneDeckTracker.exe: an HDT install (app-x.y.z) or the output of scripts/fetch-hdt.ps1. -->
    <HdtDir Condition="'$(HdtDir)' == ''">$(MSBuildThisFileDirectory)..\..\hdt-libs</HdtDir>
  </PropertyGroup>

  <!-- The core is compiled in so the plugin ships as a single DLL. -->
  <ItemGroup>
    <Compile Include="..\MulliganCore\**\*.cs" Exclude="..\MulliganCore\bin\**;..\MulliganCore\obj\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtDir)\HearthMirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthWatcher">
      <HintPath>$(HdtDir)\HearthWatcher.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckHdtDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(HdtDir)\HearthstoneDeckTracker.exe')">
    <Error Text="HearthstoneDeckTracker.exe not found in '$(HdtDir)'. Run scripts/fetch-hdt.ps1 or pass -p:HdtDir=&lt;HDT app folder&gt;." />
  </Target>
</Project>
