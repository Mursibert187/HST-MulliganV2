<Window x:Class="HstMulligan.Plugin.Config.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mulligan V2 — Settings"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101418" Foreground="#F0F0F0"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Enabled" Grid.Row="0" Grid.Column="0" Margin="0,6,0,6"/>
        <CheckBox x:Name="EnabledBox" Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" VerticalAlignment="Center"/>
        <TextBlock Text="Primary data source" Grid.Row="1" Grid.Column="0" Margin="0,6,0,6"/>
        <ComboBox x:Name="SourceCombo" Grid.Row="1" Grid.Column="1" Margin="0,6,0,6">
            <ComboBoxItem Content="firestone"/>
            <ComboBoxItem Content="hsreplay"/>
            <ComboBoxItem Content="file"/>
        </ComboBox>
        <TextBlock Text="Firestone URL template" Grid.Row="2" Grid.Column="0" Margin="0,6,0,6"/>
        <TextBox x:Name="FirestoneUrl" Grid.Row="2" Grid.Column="1" Margin="0,6,0,6"/>
        <TextBlock Text="HSReplay URL template" Grid.Row="3" Grid.Column="0" Margin="0,6,0,6"/>
        <TextBox x:Name="HsReplayUrl" Grid.Row="3" Grid.Column="1" Margin="0,6,0,6"/>
        <TextBlock Text="Offline dataset path" Grid.Row="4" Grid.Column="0" Margin="0,6,0,6"/>
        <TextBox x:Name="OfflinePath" Grid.Row="4" Grid.Column="1" Margin="0,6,0,6"/>
        <TextBlock Text="Cache TTL (minutes)" Grid.Row="5" Grid.Column="0" Margin="0,6,0,6"/>
        <TextBox x:Name="CacheTtlBox" Grid.Row="5" Grid.Column="1" Margin="0,6,0,6"/>
        <TextBlock Text="Confidence saturation n" Grid.Row="6" Grid.Column="0" Margin="0,6,0,6"/>
        <TextBox x:Name="SaturationBox" Grid.Row="6" Grid.Column="1" Margin="0,6,0,6"/>
        <TextBlock Text="Overlay opacity" Grid.Row="7" Grid.Column="0" Margin="0,6,0,6"/>
        <Slider x:Name="OpacitySlider" Grid.Row="7" Grid.Column="1" Margin="0,6,0,6"
                Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
        <TextBlock Text="Overlay scale" Grid.Row="8" Grid.Column="0" Margin="0,6,0,6"/>
        <Slider x:Name="ScaleSlider" Grid.Row="8" Grid.Column="1" Margin="0,6,0,6"
                Minimum="0.6" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
        <TextBlock Text="Show details panel" Grid.Row="9" Grid.Column="0" Margin="0,6,0,6"/>
        <CheckBox x:Name="DetailsBox" Grid.Row="9" Grid.Column="1" Margin="0,6,0,6" VerticalAlignment="Center"/>

        <Separator Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,6" Background="#333"/>
        <TextBlock Text="Pinned deck"
                   Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="0,14,0,0"
                   FontWeight="SemiBold" Foreground="#B8B8B8"/>

        <TextBlock Text="Only show for pinned deck" Grid.Row="11" Grid.Column="0" Margin="0,6,0,6"/>
        <CheckBox x:Name="OnlyPinnedBox" Grid.Row="11" Grid.Column="1" Margin="0,6,0,6" VerticalAlignment="Center"/>
        <TextBlock Text="HSReplay shortId" Grid.Row="12" Grid.Column="0" Margin="0,6,0,6"/>
        <TextBox x:Name="PinnedShortIdBox" Grid.Row="12" Grid.Column="1" Margin="0,6,0,6"
                 ToolTip="Last path segment of your HSReplay deck URL, e.g. Tqcm39067GQSMafXBbErHe"/>
        <TextBlock Text="Pinned URL template" Grid.Row="13" Grid.Column="0" Margin="0,6,0,6"/>
        <TextBox x:Name="PinnedUrlBox" Grid.Row="13" Grid.Column="1" Margin="0,6,0,6"
                 ToolTip="Supports {shortId}, {format}, {rank} placeholders"/>
        <TextBlock Text="Pinned signature" Grid.Row="14" Grid.Column="0" Margin="0,6,0,6"/>
        <Grid Grid.Row="14" Grid.Column="1" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PinnedSigBox" Grid.Column="0" IsReadOnly="True"
                     Background="#1A1E24" Foreground="#B8B8B8"/>
            <Button x:Name="PinCurrentDeckButton" Grid.Column="1"
                    Content="Pin current deck"
                    Margin="8,0,0,0" Padding="10,2"
                    Click="PinCurrentDeckButton_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button x:Name="ImportButton" Content="Import JSON…" Width="120" Margin="0,0,8,0" Click="ImportButton_Click"/>
            <Button x:Name="ExportButton" Content="Export JSON…" Width="120" Margin="0,0,8,0" Click="ExportButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Save" Width="90" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
