<UserControl x:Class="HstMulligan.Plugin.Overlay.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="True"
             Background="#DD0C1018">
    <Border Padding="10" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Orientation="Vertical" MinWidth="360">
            <TextBlock x:Name="HeaderText"
                       Foreground="#F0F0F0"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Text="mulligan guide"/>
            <TextBlock x:Name="SubHeader"
                       Foreground="#B8B8B8"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,2,0,8"
                       Text=""/>
            <ItemsControl x:Name="Rows"/>
        </StackPanel>
    </Border>
</UserControl>
